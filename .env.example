# ============================================================
#  B站视频转图文笔记流水线 · 配置
#  用法：把本文件复制为 .env，填入 API Key 即可
# ============================================================

# ---------- 视觉模型（给截图打分 + 提取图中文字/流程图）----------
# 智谱 GLM-4V-Flash：完全免费，注册即用
# 申请地址：https://open.bigmodel.cn/  控制台 -> API Keys
VISION_API_KEY=在这里填你的智谱API_Key
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
VISION_MODEL=glm-4v-flash

# ---------- 文本模型（融合字幕写笔记正文）----------
# 不填则自动复用上面的 VISION_API_KEY / VISION_BASE_URL
TEXT_API_KEY=
TEXT_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
TEXT_MODEL=glm-4-flash

# ---------- 并发与超时 ----------
WORKERS=8
TIMEOUT=120
# 视觉模型单次输出上限。智谱 glm-4v-flash 硬上限为 1024，超过会直接 400。
# 换成上限更高的模型时可调大；填错也没关系，程序会按服务端提示自动降级重试。
VISION_MAX_TOKENS=1024

# ============================================================
#  备选方案（想换模型时把上面对应几行替换掉即可）
# ------------------------------------------------------------
#  通义千问（阿里云百炼，新用户有免费额度）
#    VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#    VISION_MODEL=qwen-vl-plus
#    TEXT_MODEL=qwen-plus
#
#  硅基流动（有免费模型档位）
#    VISION_BASE_URL=https://api.siliconflow.cn/v1
#    VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# ============================================================

# ---------- ima 知识库自动入库（可选）----------
# 目标知识库 ID：先确保 .workbuddy/skills/ima-skills 已配置好 ima 凭证，
# 再运行 `python to_ima.py --list-kb` 查看可用知识库，把对应 id 填到这里。
# 命令行也可用 --kb-id / --kb-name 覆盖，--no-ima 跳过。
IMA_KB_ID=

# ---------- 垃圾帧过滤（可选）----------
# 当帧的 theme/keywords/OCR 文本里出现以下关键词时，直接剔除（不入选最终笔记）。
# 逗号分隔，支持正则。例：白嫖,一键三连,求赞,点赞关注,记得投币
FRAME_TRASH_KEYWORDS=白嫖,一键三连,求赞,点赞关注,记得投币,关注,三连,投币,点赞,资料,领取,免费,加微信,小助理,扣666,扣个666,课程,训练营,私教,咨询,优惠,报名,付费,会员,专栏,扫码,进群,福利,面试题,完整资料
# 入选帧的最低 AI 分数；低于此分数即使没命中黑名单也不会被选中。
FRAME_MIN_SCORE=3

# 跳过片头 N 秒（去掉 UP 主求三连/片头动画等）。设为 0 表示不跳过。
SKIP_HEAD_SECONDS=0

# ---------- 广告/卖课时间段过滤（可选）----------
# 抽帧前扫描字幕，命中以下关键词即视为广告/卖课段，向前后扩展 AD_CONTEXT_SECONDS 秒后跳过。
# 逗号分隔，支持中文。留空则使用内置默认关键词。
AD_KEYWORDS=资料,领取,免费,加微信,小助理,扣666,扣个666,点赞关注,一键三连,求赞,课程,训练营,私教,咨询,优惠,报名,付费,会员,专栏,扫码,进群,福利
# 命中广告关键词后向前后扩展的秒数（默认 20）
AD_CONTEXT_SECONDS=20

# ---------- 低价值画面类型过滤（可选）----------
# 视觉模型会输出每帧的 type，命中以下类型的帧直接剔除。
# 逗号分隔，默认：meme（表情包）, blackscreen（黑屏字幕）, ad（广告）, face（人脸）。
FRAME_TYPE_TRASH=meme,blackscreen,ad,face

# 自进化黑名单文件路径。运行 learn_trash.py 后，漏网垃圾帧的特征会追加到此文件，
# 下次 auto_select 自动加载并剔除相似帧。留空则默认使用项目根目录 trash_learned.json。
LEARNED_TRASH_FILE=

